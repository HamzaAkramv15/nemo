# nemo from the release's ready binaries (tools/dist.sh), one package per program.
# Updates and modules are the package manager's: stage.sh --managed leaves the mark the shell looks for.
pkgbase=nemo-bin
pkgname=(nemo-shell-bin nemo-files-bin nemo-view-bin nemo-play-bin nemo-shot-bin nemo-greet-bin)
pkgver=3.2.0
pkgrel=1
pkgdesc='Lightweight pixel-art Wayland desktop for the niri compositor'
arch=(x86_64)
url='https://github.com/HamzaAkramv15/nemo'
license=(MIT)
options=(!strip !debug)
source=("https://github.com/HamzaAkramv15/nemo/releases/download/v$pkgver/nemo-$pkgver-x86_64-linux.tar.gz")
sha256sums=('80fe4565b4a969bc480de91d6f4c4a4898adfc269221e414561c83944e3cd10c') # tools/release.sh writes it

_put() { cd "nemo-$pkgver-x86_64-linux" && ./stage.sh --prefix /usr --destdir "$pkgdir" --managed --only "$1"; }

package_nemo-shell-bin() {
  pkgdesc='nemo: bar, launcher, dock, lock screen, notifications, widgets and the password, screen-share and automount services for niri'
  depends=(niri pam polkit libxkbcommon gcc-libs glibc)
  optdepends=('nemo-files-bin: file manager and the file dialog' 'nemo-view-bin: images' 'nemo-play-bin: video and music'
    'nemo-shot-bin: screenshots' 'nemo-greet-bin: login screen'
    'grim: screenshots' 'wl-clipboard: clipboard' 'cliphist: clipboard history' 'playerctl: music' 'brightnessctl: brightness'
    'wlsunset: night light' 'kitty: the terminal nemo restyles' 'udisks2: automount of drives' 'gvfs: phones and cameras')
  provides=(nemo-shell) conflicts=(nemo-shell)
  _put nemo-shell
}
package_nemo-files-bin() {
  pkgdesc='nemo-files: file manager, file dialog of every app, drives and phones'
  depends=(libxkbcommon gcc-libs glibc)
  optdepends=('ffmpegthumbnailer: video thumbnails' 'libarchive: archives' 'udisks2: drives' 'gvfs: phones and network places')
  provides=(nemo-files) conflicts=(nemo-files)
  _put nemo-files
}
package_nemo-view-bin() {
  pkgdesc='nemo-view: image viewer with quick edits'
  depends=(libxkbcommon gcc-libs glibc)
  provides=(nemo-view) conflicts=(nemo-view)
  _put nemo-view
}
package_nemo-play-bin() {
  pkgdesc='nemo-play: video and music player'
  depends=(mpv libxkbcommon gcc-libs glibc)
  provides=(nemo-play) conflicts=(nemo-play)
  _put nemo-play
}
package_nemo-shot-bin() {
  pkgdesc='nemo-shot: screenshots, marks, text and QR'
  depends=(grim libxkbcommon gcc-libs glibc)
  optdepends=('tesseract: text from screenshots' 'zbar: QR codes')
  provides=(nemo-shot) conflicts=(nemo-shot)
  _put nemo-shot
}
package_nemo-greet-bin() {
  pkgdesc='nemo-greet: login screen for greetd'
  depends=(greetd niri libxkbcommon gcc-libs glibc)
  provides=(nemo-greet) conflicts=(nemo-greet)
  _put nemo-greet
}
