#!/bin/sh
# yami-script: branch and changes of a git folder (set REPO in this file, e.g. REPO=$HOME/projects/app)
cd "${REPO:-$HOME}" 2>/dev/null || exit 0
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then printf '{"text":"no repo","icon":"folder","color":"dim","interval":30}\n'; exit 0; fi
b=$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD)
n=$(git status --porcelain 2>/dev/null | wc -l)
b=$(printf %s "$b" | tr -d '"\\' | cut -c1-24)
if [ "$n" -gt 0 ]; then printf '{"text":"%s +%s","icon":"folder","color":"warn","interval":15}\n' "$b" "$n"; else printf '{"text":"%s","icon":"folder","color":"ok","interval":15}\n' "$b"; fi
