#!/bin/sh
# yami-script: the phase of the moon (an approximation, good to about a day)
days=$(( ($(date +%s) - 947182440) / 86400 ))            # since the new moon of 2000-01-06
age=$(awk -v d="$days" 'BEGIN { a = d % 29.530588; if (a < 0) a += 29.530588; printf "%d", a + 0.5 }')
case $age in
  0|1|29) n="new moon" ;;
  2|3|4|5|6) n="waxing crescent" ;;
  7|8) n="first quarter" ;;
  9|10|11|12|13) n="waxing gibbous" ;;
  14|15|16) n="full moon" ;;
  17|18|19|20|21) n="waning gibbous" ;;
  22|23) n="last quarter" ;;
  *) n="waning crescent" ;;
esac
printf '{"text":"%s","icon":"moon","color":"dim","interval":3600}\n' "$n"
