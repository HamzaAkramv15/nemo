#!/bin/sh
# nemo-script: free space on / (set DISK_PATH in the script for another place); amber above 85% used
p=${DISK_PATH:-/}
set -- $(df -P "$p" 2>/dev/null | awk 'NR == 2 { gsub("%", "", $5); print $4, $5 }')
if [ -z "$2" ]; then printf '{"text":"disk ?","icon":"folder","color":"dim","interval":300}\n'; exit 0; fi
free=$(awk -v k="$1" 'BEGIN { g = k / 1048576; if (g >= 100) printf "%.0fG", g; else printf "%.1fG", g }')
c=text
[ "$2" -ge 85 ] && c=warn
printf '{"text":"%s free","icon":"folder","color":"%s","click":"xdg-open %s","interval":120}\n' "$free" "$c" "$p"
