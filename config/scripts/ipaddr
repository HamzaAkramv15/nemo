#!/bin/sh
# yami-script: this machine's address on the local network (nothing leaves the machine)
ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')
if [ -n "$ip" ]; then
  printf '{"text":"%s","icon":"net","color":"text","click":"sh -c '"'"'printf %%s %s | wl-copy'"'"'","interval":15}\n' "$ip" "$ip"
else
  printf '{"text":"offline","icon":"net","color":"dim","interval":15}\n'
fi
